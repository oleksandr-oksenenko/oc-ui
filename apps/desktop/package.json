{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop client for OpenCode.",
  "author": "Oleksandr Oksenenko",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -b && electron-vite build",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry",
    "check": "vp check",
    "make:mac": "pnpm run build && pnpm run stage:opencode && electron-builder --config electron-builder.config.mjs --mac dir dmg --arm64",
    "predev": "install-electron --no",
    "package:mac": "pnpm run build && pnpm run stage:opencode && electron-builder --config electron-builder.config.mjs --mac dir --arm64",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "stage:opencode": "node ../../tools/stage-opencode.mjs",
    "storybook": "storybook dev --port 6006 --disable-telemetry",
    "storybook:preview": "vp preview --outDir storybook-static --host 127.0.0.1 --port 4174",
    "test:acceptance:mac": "pnpm run package:mac && node test/e2e/run-packaged.mjs",
    "test:acceptance:mac:wdio": "wdio run wdio.conf.ts",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@kobalte/core": "catalog:",
    "@opencode-ai/cli": "catalog:",
    "@opencode-ai/client": "catalog:",
    "@opencode-ai/ui": "catalog:",
    "@pierre/diffs": "catalog:",
    "@solidjs/meta": "catalog:",
    "dompurify": "catalog:",
    "effect": "4.0.0-rc.111",
    "marked": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/mocha": "catalog:",
    "@wdio/cli": "catalog:",
    "@wdio/electron-service": "catalog:",
    "@wdio/globals": "catalog:",
    "@wdio/local-runner": "catalog:",
    "@wdio/mocha-framework": "catalog:",
    "@wdio/spec-reporter": "catalog:",
    "@wdio/types": "catalog:",
    "electron": "catalog:",
    "electron-builder": "26.15.3",
    "electron-vite": "catalog:",
    "jsdom": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "10.7.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vite-plus": "catalog:"
  }
}
