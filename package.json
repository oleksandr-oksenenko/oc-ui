{
  "name": "ocui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run desktop#build",
    "check": "vp check && tsc -p apps/desktop/tsconfig.wdio.json --noEmit && pnpm lint:styles && pnpm check:components && knip",
    "check:components": "node tools/check-component-layout.mjs",
    "dev": "vp run --no-cache desktop#dev",
    "dev:web": "pnpm --filter desktop dev:web",
    "build:web": "pnpm --filter desktop build:web",
    "preview:web": "pnpm --filter desktop preview:web",
    "format": "vp fmt",
    "knip": "knip",
    "lint": "vp lint && pnpm lint:styles",
    "lint:styles": "stylelint \"apps/**/*.css\"",
    "opencode:server": "pnpm --filter desktop exec opencode2 serve",
    "opencode:version": "pnpm --filter desktop exec opencode2 --version",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "ready": "pnpm check && vp run desktop#test && vp run desktop#build && vp run desktop#build:web && vp run desktop#build-storybook",
    "storybook": "vp run desktop#storybook",
    "storybook:preview": "vp run desktop#storybook:preview",
    "build-storybook": "vp run desktop#build-storybook",
    "package:mac": "pnpm --filter desktop package:mac",
    "make:mac": "pnpm --filter desktop make:mac",
    "test:acceptance:mac": "pnpm --filter desktop test:acceptance:mac",
    "test:acceptance:chat:mac": "pnpm --filter desktop test:acceptance:chat:mac",
    "test": "vp run desktop#test"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "^26.3.0",
    "@typescript/typescript6": "6.0.2",
    "knip": "^6.32.2",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
