{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**"],
  "ignoreDependencies": ["oxlint", "oxlint-tsgolint"],
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "src/main/opencode-worker.ts",
        "stories/**/*.stories.{ts,tsx}",
        "test/e2e/**/*.e2e.ts",
        "scripts/**/*.{ts,mjs}",
        "electron-builder.config.mjs",
        "src/renderer/browser.ts",
        "vite.web.config.ts"
      ],
      "ignoreDependencies": ["@wdio/local-runner"]
    }
  }
}
