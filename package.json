{
  "name": "ocui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run desktop#build",
    "check": "vp check && pnpm check:components && knip",
    "check:components": "node tools/check-component-layout.mjs",
    "dev": "vp run desktop#dev",
    "format": "vp fmt",
    "knip": "knip",
    "lint": "vp lint",
    "opencode:server": "opencode2 serve",
    "opencode:version": "opencode2 --version",
    "ready": "pnpm check && vp run desktop#test && vp run desktop#build",
    "storybook": "vp run desktop#storybook",
    "storybook:preview": "vp run desktop#storybook:preview",
    "build-storybook": "vp run desktop#build-storybook",
    "test": "vp run desktop#test"
  },
  "devDependencies": {
    "@opencode-ai/cli": "0.0.0-beta-18155",
    "@types/node": "^26.3.0",
    "@typescript/typescript6": "6.0.2",
    "knip": "^6.32.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.23.0"
}
